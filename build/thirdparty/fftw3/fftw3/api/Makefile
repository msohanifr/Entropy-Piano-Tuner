	-$(DEL_FILE) ../../../fftw3/$(TARGET) 
	-$(DEL_FILE) ../../../fftw3/$(TARGET0) ../../../fftw3/$(TARGET1) ../../../fftw3/$(TARGET2) $(TARGETA)
