	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../../fftw3/$(TARGET)
	-$(MOVE) $(TARGET) ../../../fftw3/$(TARGET)
	-$(DEL_FILE) ../../../fftw3/$(TARGET0)
	-$(DEL_FILE) ../../../fftw3/$(TARGET1)
	-$(DEL_FILE) ../../../fftw3/$(TARGET2)
	-$(MOVE) $(TARGET0) ../../../fftw3/$(TARGET0)
	-$(MOVE) $(TARGET1) ../../../fftw3/$(TARGET1)
	-$(MOVE) $(TARGET2) ../../../fftw3/$(TARGET2)



staticlib: ../../../fftw3/libfftw3.a

