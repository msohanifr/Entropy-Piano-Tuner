../bin/entropypianotuner.app/Contents/PkgInfo: 
	@test -d ../bin/entropypianotuner.app/Contents || mkdir -p ../bin/entropypianotuner.app/Contents
	@$(DEL_FILE) ../bin/entropypianotuner.app/Contents/PkgInfo
	@echo "APPL????" > ../bin/entropypianotuner.app/Contents/PkgInfo
../bin/entropypianotuner.app/Contents/Info.plist: 
	@test -d ../bin/entropypianotuner.app/Contents || mkdir -p ../bin/entropypianotuner.app/Contents
	@$(DEL_FILE) ../bin/entropypianotuner.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - platforms/osx/Info.plist | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.entropypianotuner,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.entropypianotuner,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},14.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,entropytuner.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},entropytuner.icns,g" -e "s,@EXECUTABLE@,entropypianotuner,g" -e "s,@LIBRARY@,entropypianotuner,g" -e "s,\$${EXECUTABLE_NAME},entropypianotuner,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >../bin/entropypianotuner.app/Contents/Info.plist
