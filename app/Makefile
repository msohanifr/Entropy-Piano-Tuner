	@test -d $(INSTALL_ROOT)/Users/matsohani/piano_tuner/app/bin || mkdir -p $(INSTALL_ROOT)/Users/matsohani/piano_tuner/app/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/Users/matsohani/piano_tuner/app/bin/entropypianotuner.app
	
	$(QINSTALL) ../bin/entropypianotuner.app $(INSTALL_ROOT)/Users/matsohani/piano_tuner/app/bin/entropypianotuner.app
	-$(STRIP) $(INSTALL_ROOT)/Users/matsohani/piano_tuner/app/bin/entropypianotuner.app/Contents/MacOS/$(QMAKE_TARGET)

