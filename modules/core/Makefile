install_target: first FORCE
	@test -d $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner || mkdir -p $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner
	$(QINSTALL) ../../bin/$(TARGET) $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner/$(TARGET)
	$(RANLIB) $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/Users/matsohani/piano_tuner/modules/core/lib/entropypianotuner/ 


